# Python bytecode
__pycache__/
*.py[cod]

# Virtual environment & env vars
venv/
.venv/

# Cualquier archivo de variables de entorno, en cualquier carpeta. La regla es
# un patrón y no una ruta fija para que también cubra los archivos que generan
# los scripts (por ejemplo staging/credenciales.env). Las plantillas de ejemplo
# sí se publican, porque no llevan valores reales.
*.env
!*.env.example

# Django
*.log
db.sqlite3

/staticfiles/
/media/

# Documentación interna (no se publica en el repo remoto)
/docs/

# IDEs & system
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.VSCodeCounter/

# Sensitive files
*.ppk
*.sql
*.sql.gz
*.gz
backups/

# Staging local: dumps de producción y correos capturados. El archivo de
# credenciales ya queda cubierto por la regla *.env de más arriba.
staging/dumps/
staging/correos/

# Temporary files
ultimo_reporte.xlsx
*.xlsx~

# Fix/migration scripts (one-time use)
add_*.py
fix_*.py
check_*.py
clear_*.py
find_*.py
normalizar.py
reorder_*.py
simple_fix.py
template_config.py
test_cloud.py
cleanup_*.py
prepare_*.py
# Template para nuevo archivo .env
# Reemplaza los valores <...> con tus nuevas credenciales

# ============================================
# DJANGO CONFIGURATION
# ============================================
SECRET_KEY=<GENERA_UNA_NUEVA_CON: python generate_secret_key.py>
DEBUG=True

# ============================================
# MYSQL DATABASE - CLEVER CLOUD
# ============================================
DB_NAME=<nuevo_db_name_de_clever_cloud>
DB_USER=<nuevo_user_de_clever_cloud>
DB_PASSWORD=<nuevo_password_de_clever_cloud>
DB_HOST=<nuevo_host_de_clever_cloud>
DB_PORT=3306

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST_USER=<tu_nuevo_correo_institucional>
EMAIL_HOST_PASSWORD=<password_si_es_necesario>

# ============================================
# CLOUDINARY - MEDIA STORAGE
# ============================================
# Opción 1: Mantener credenciales actuales
# Opción 2: Usar nuevas credenciales de nueva cuenta
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# ============================================
# SENDGRID - EMAIL SERVICE (PRODUCCIÓN)
# ============================================
SENDGRID_API_KEY=<sendgrid_api_key_cuando_la_tengas>
EMAIL_FROM=<tu_nuevo_correo_institucional>
EMAIL_RECIPIENTS=<emails_separados_por_comas>

# ============================================
# RENDER DEPLOYMENT (solo en producción)
# ============================================
# RENDER_EXTERNAL_HOSTNAME=<tu-app>.onrender.com
